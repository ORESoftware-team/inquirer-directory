{
  "name": "inquirer-directory",
  "version": "2.1.0",
  "description": "a directory (relative to given path) selector for Inquirer.js",
  "main": "index.js",
  "scripts": {
    "test": "node_modules/.bin/_mocha test/spec",
    "preversion": "npm test",
    "postversion": "git push && git push --tags",
    "lint:ores": "if [ -f .ores-lint/lint.sh ]; then sh .ores-lint/lint.sh; else echo 'ores-lint not installed'; fi",
    "prepublishOnly": "npm run lint:ores"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nicksrandall/inquierer-directory.git"
  },
  "keywords": [
    "Inquirer",
    "directory",
    "prompt"
  ],
  "author": "Nick Randall <nicksrandall@gmail.com> (http://nickrandall.com)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/nicksrandall/inquierer-directory/issues"
  },
  "homepage": "https://github.com/nicksrandall/inquierer-directory#readme",
  "dependencies": {
    "chalk": "^1.1.1",
    "cli-cursor": "^1.0.2",
    "figures": "^1.4.0",
    "inquirer": "^1.1.3",
    "lodash": "^3.10.1",
    "rx-lite": "^4.0.8",
    "util": "^0.10.3"
  },
  "devDependencies": {
    "chai": "^3.4.1",
    "events": "^1.1.0",
    "mocha": "^2.3.4",
    "mock-fs": "^3.5.0",
    "sinon": "^1.17.2"
  },
  "oresLint": {
    "note": "Declared, not installed. ores-lint resolves these from a global install - see .ores-lint/README.md",
    "requires": {
      "eslint": ">=9",
      "typescript-eslint": ">=8 (optional; without it .ts files are skipped)"
    },
    "install": "npm i -g eslint typescript-eslint"
  }
}
